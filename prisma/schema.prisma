generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Account {
  id           String   @id
  name         String
  passwordHash String   @map("password_hash")
  passwordSalt String   @map("password_salt")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz()
  sessions     Session[]

  @@map("accounts")
}

model Session {
  id        String   @id
  tokenHash String   @unique @map("token_hash")
  accountId String   @map("account_id")
  expiresAt DateTime @map("expires_at") @db.Timestamptz()
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  account   Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId], map: "sessions_account_idx")
  @@map("sessions")
}

model Meal {
  id                 String    @id
  date               String
  time               String
  endTime            String    @default("") @map("end_time")
  type               String
  foods              String
  quantity           Float?
  quantityUnit       String    @map("quantity_unit")
  consistency        String
  consistencyPercent Int?      @map("consistency_percent")
  calories           Float?
  notes              String    @default("")
  hasBeforePhoto     Boolean   @default(false) @map("has_before_photo")
  hasAfterPhoto      Boolean   @default(false) @map("has_after_photo")
  source             String    @default("")
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt          DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()
  items              MealItem[]
  reactions          FoodReaction[]

  @@index([date, time], map: "meals_date_idx")
  @@map("meals")
}

model Poop {
  id        String   @id
  date      String
  time      String
  bristol   Int      @db.SmallInt
  color     String
  amount    String
  straining Boolean  @default(false)
  pain      Boolean  @default(false)
  mucus        Boolean  @default(false)
  visibleBlood Boolean  @default(false) @map("visible_blood")
  hasPhoto     Boolean  @default(false) @map("has_photo")
  notes        String   @default("")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  @@index([date, time], map: "poops_date_idx")
  @@map("poops")
}

model Mood {
  id        String   @id
  date      String
  time      String
  mood      String
  notes     String   @default("")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  @@index([date, time], map: "moods_date_idx")
  @@map("moods")
}

model Water {
  id        String   @id
  date      String
  time      String
  amount    Float
  unit      String
  notes     String   @default("")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  @@index([date, time], map: "waters_date_idx")
  @@map("waters")
}

model DayNote {
  date      String   @id
  note      String
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  @@map("day_notes")
}

/// Photos are stored without a meal foreign key so a before/after image can be
/// uploaded with a new meal id before the meal row itself exists.
model MealPhoto {
  mealId String @map("meal_id")
  slot   String
  mime   String
  bytes  Bytes

  @@id([mealId, slot])
  @@map("meal_photos")
}

/// Built-in catalogue foods (is_custom = false, seeded on boot) and parents' custom foods.
/// Nutrients are per 100 g; a null nutrient means "unknown", never zero.
model FoodItem {
  id             String     @id
  name           String
  aliases        Json       @default("[]")
  category       String
  foodGroups     Json       @default("[]") @map("food_groups")
  defaultUnit    String     @map("default_unit")
  defaultQty     Float?     @map("default_qty")
  unitGrams      Json       @default("{}") @map("unit_grams")
  nutrients      Json       @default("{}")
  nutrientSource String     @default("none") @map("nutrient_source")
  ingredients    Json       @default("[]")
  isCustom       Boolean    @default(false) @map("is_custom")
  createdAt      DateTime   @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt      DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()
  mealItems      MealItem[]
  reactions      FoodReaction[]

  @@index([isCustom], map: "food_items_custom_idx")
  @@map("food_items")
}

/// One food in a meal. Ingredients of a composite dish point at their dish via parentItemId.
model MealItem {
  id               String     @id
  mealId           String     @map("meal_id")
  parentItemId     String?    @map("parent_item_id")
  foodItemId       String?    @map("food_item_id")
  foodName         String     @map("food_name")
  quantityServed   Float?     @map("quantity_served")
  quantityConsumed Float?     @map("quantity_consumed")
  unit             String
  consumedPercent  Int?       @map("consumed_percent") @db.SmallInt
  preparation      String     @default("")
  notes            String     @default("")
  position         Int        @default(0)
  meal             Meal       @relation(fields: [mealId], references: [id], onDelete: Cascade)
  parent           MealItem?  @relation("Ingredients", fields: [parentItemId], references: [id], onDelete: Cascade)
  ingredients      MealItem[] @relation("Ingredients")
  food             FoodItem?  @relation(fields: [foodItemId], references: [id], onDelete: SetNull)

  @@index([mealId], map: "meal_items_meal_idx")
  @@index([foodItemId], map: "meal_items_food_idx")
  @@map("meal_items")
}

/// Previous versions of edited or deleted records, so history edits never silently lose data.
model RecordRevision {
  id        String   @id
  entity    String
  entityId  String   @map("entity_id")
  action    String
  data      Json
  changedAt DateTime @default(now()) @map("changed_at") @db.Timestamptz()

  @@index([entity, entityId], map: "record_revisions_entity_idx")
  @@map("record_revisions")
}

model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  @@map("settings")
}

model Symptom {
  id              String         @id
  date            String
  time            String
  type            String
  otherLabel      String         @default("") @map("other_label")
  severity        String
  durationMinutes Int?           @map("duration_minutes")
  notes           String         @default("")
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt       DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()
  reactions       FoodReaction[]

  @@index([date, time], map: "symptoms_date_idx")
  @@map("symptoms")
}

/// A parent-recorded suspicion that a food eaten before a symptom may be related.
/// It is an observation to keep watching, never a diagnosis.
model FoodReaction {
  id              String    @id
  symptomId       String    @map("symptom_id")
  foodItemId      String?   @map("food_item_id")
  mealId          String?   @map("meal_id")
  foodName        String    @map("food_name")
  consumedDate    String    @map("consumed_date")
  consumedTime    String    @map("consumed_time")
  severity        String
  previousSimilar String    @default("unsure") @map("previous_similar")
  notes           String    @default("")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()
  symptom         Symptom   @relation(fields: [symptomId], references: [id], onDelete: Cascade)
  food            FoodItem? @relation(fields: [foodItemId], references: [id], onDelete: SetNull)
  meal            Meal?     @relation(fields: [mealId], references: [id], onDelete: SetNull)

  @@index([symptomId], map: "food_reactions_symptom_idx")
  @@index([foodItemId], map: "food_reactions_food_idx")
  @@map("food_reactions")
}

model DailyMetric {
  date           String   @id
  appetite       String   @default("")
  energy         String   @default("")
  sleepHours     Float?   @map("sleep_hours")
  digestionNotes String   @default("") @map("digestion_notes")
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  @@map("daily_metrics")
}

model GrowthRecord {
  id        String   @id
  date      String
  weightKg  Float?   @map("weight_kg")
  heightCm  Float?   @map("height_cm")
  position  String   @default("")
  notes     String   @default("")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  @@index([date])
  @@map("growth_records")
}

/// Explicit status for one of the five scheduled meal slots on a date. Only "not eaten" is stored;
/// "eaten" comes from meal entries and "not logged" is the absence of both.
model MealSlot {
  date      String
  mealType  String   @map("meal_type")
  status    String
  note      String   @default("")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  @@id([date, mealType])
  @@map("meal_slots")
}
